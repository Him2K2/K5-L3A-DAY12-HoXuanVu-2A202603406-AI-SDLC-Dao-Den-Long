        "shades": [{ "id": "S1", "pos": [0, 1, 30] }] },
      "expect": { "events": ["fuel_drain"], "final": { "shades.0.state": "drain", "shades.0.target_lantern_id": "L1" } }
    },
    {
      "name": "drain-pulse-bonus", "night": 1, "ticks": 1, "ac": "P3.9/P3.16",
      "scenario": { "random_motes": false, "random_shades": false, "motes": [], "player": { "pos": [0, 0, 22], "carried": 3 },
        "lanterns": [{ "id": "L1", "lit": true, "fuel": 25 }], "shades": [{ "id": "S1", "pos": [0, 1, 26.5], "state": "drain", "target_lantern_id": "L1" }] },
      "inputs": { "frames": [{ "tick": 0, "pulse": true }] },
      "expect": { "events": ["pulse"], "final": { "score": 15, "shades.0.state": "stunned" } }
    },
    {
      "name": "refuel-ejects-shade", "night": 1, "ticks": 60, "ac": "P3.10",
      "scenario": { "random_motes": false, "random_shades": false, "motes": [], "player": { "pos": [0, 0, 23.5], "carried": 10 },
        "lanterns": [{ "id": "L1", "lit": true, "fuel": 25 }], "shades": [{ "id": "S1", "pos": [0.5, 1, 23.5], "state": "chase" }] },
      "inputs": { "frames": [{ "tick": 0, "interact": true }] },
      "expect": { "events": ["refuel"], "no_events": ["player_hit"] }
