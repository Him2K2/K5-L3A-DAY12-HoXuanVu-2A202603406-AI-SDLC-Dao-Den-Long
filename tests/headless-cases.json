      "inputs": { "frames": [{ "tick": 0, "move": [0, 1] }, { "tick": 10, "pause": true }, { "tick": 11, "pause": false }, { "tick": 20, "pause": true }] },
      "expect": { "events": ["paused", "resumed"], "final": { "sim_tick": 20, "player.pos.2": 2.0 } }
