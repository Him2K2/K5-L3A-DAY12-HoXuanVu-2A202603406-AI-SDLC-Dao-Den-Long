      "scenario": { "random_motes": false, "random_shades": false, "random_drifters": false, "wind_enabled": false, "motes": [], "shades": [], "player": { "pos": [26.414, 0, 15.25] } },
      "inputs": { "frames": [{ "tick": 0, "move": [-0.866, -0.5] }] },
      "expect": { "final": { "player.pos.1": 3, "player.grounded": true } }
