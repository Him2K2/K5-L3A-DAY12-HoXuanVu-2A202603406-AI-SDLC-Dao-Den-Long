{
  "_doc": "Headless scenarios (Contract v1.1), at least one per new feature. Run: node scripts/gen-evidence.js. 'expect.events' must all appear; 'expect.final' compares paths on the last snapshot; 'expect.no_events' must not appear.",
  "cases": [
    {
      "name": "run-speed", "night": 1, "ticks": 60, "ac": "AC1.1",
      "scenario": { "random_motes": false, "random_shades": false, "motes": [], "shades": [] },
      "inputs": { "frames": [{ "tick": 0, "move": [0, 1] }] },
      "expect": { "final": { "player.pos.2": 6 } }
    },
    {
      "name": "dash", "night": 1, "ticks": 12, "ac": "AC1.3",
      "scenario": { "random_motes": false, "random_shades": false, "motes": [], "shades": [] },
      "inputs": { "frames": [{ "tick": 0, "dash": true }] },
      "expect": { "events": ["dash"], "final": { "player.pos.2": 2.8, "player.dash_cd_s": 1.317 } }
    },
    {
      "name": "deposit-and-light", "night": 1, "ticks": 2, "ac": "AC1.6",
      "scenario": { "random_motes": false, "random_shades": false, "motes": [], "shades": [], "player": { "pos": [0, 0, 23.5], "carried": 10 } },
      "inputs": { "frames": [{ "tick": 0, "interact": true }] },
      "_p3": "UPDATED: per_mote 10 -> 5, so 10 motes + first light = 50 + 100 = 150 (was 200).",
      "expect": { "events": ["deposit", "lantern_lit"], "final": { "score": 150, "lanterns.0.fuel": 100, "player.capacity": 12 } }
    },
    {
      "name": "safe-zone-eject", "night": 1, "ticks": 90, "ac": "AC1.7",
      "scenario": { "random_motes": false, "random_shades": false, "motes": [], "player": { "pos": [0, 0, 23.5], "carried": 10 }, "shades": [{ "id": "S1", "pos": [0.5, 1, 23.5], "state": "chase" }] },
      "inputs": { "frames": [{ "tick": 0, "interact": true }] },
      "expect": { "events": ["lantern_lit"], "no_events": ["player_hit"] }
    },
    {
      "name": "pulse-stun", "night": 1, "ticks": 15, "ac": "AC1.8",
      "scenario": { "random_motes": false, "random_shades": false, "motes": [], "player": { "carried": 3 }, "shades": [{ "id": "S1", "pos": [3, 1, 0] }] },
      "inputs": { "frames": [{ "tick": 0, "pulse": true }] },
      "expect": { "events": ["pulse"], "final": { "shades.0.state": "stunned", "shades.0.pos.0": 7, "score": 5 } }
    },
    {
      "name": "shade-hit-drop", "night": 1, "ticks": 2, "ac": "AC1.11",
