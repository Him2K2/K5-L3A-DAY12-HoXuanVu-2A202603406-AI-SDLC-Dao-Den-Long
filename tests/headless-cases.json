      "inputs": { "frames": [{ "tick": 0, "move": [1, 0] }, { "tick": 30, "move": [0, 0] }] },
      "expect": { "events": ["player_hit"], "final": { "player.pos.0": 0, "player.flames": 2, "player.carried": 0 } }
