      "expect": { "events": ["player_hit"], "final": { "player.flames": 2, "player.carried": 4, "shades.0.state": "recoil", "motes_active": 3 } }
    },
    {
      "name": "shade-spawn-schedule", "night": 1, "ticks": 780, "ac": "AC1.10",
      "scenario": { "random_motes": false },
      "expect": { "events": ["shade_spawned"], "final": { "shades.2.id": "S3" } }
    },
    {
      "name": "fall-respawn", "night": 1, "ticks": 150, "ac": "AC1.12",
